# Copy to .env and edit. Never commit .env.
APP_ENV=development            # set to 'production' on servers (enforces a strong SECRET_KEY, adds HSTS)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_PATH=data/app.db
TOKEN_TTL_SECONDS=1800
CORS_ORIGINS=                  # comma-separated allowed origins; empty = same-origin only
RATELIMIT_ENABLED=1
RATELIMIT_LOGIN=10             # login/register attempts per minute per IP
PORT=8000
